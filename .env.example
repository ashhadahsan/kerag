# KERAG Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key
GOOGLE_API_KEY=your_google_api_key_here

# xAI API Key
XAI_API_KEY=your_xai_api_key_here

# General API Key (fallback)
API_KEY=your_general_api_key_here

# Knowledge Base Configuration
SPARQL_ENDPOINT=http://your-sparql-endpoint.com/sparql
API_ENDPOINT=https://your-api-endpoint.com

# LLM Configuration
DEFAULT_LLM_MODEL=gpt-4
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=1000

# Retrieval Configuration
DEFAULT_MAX_HOPS=3
DEFAULT_MAX_ENTITIES=1000
DEFAULT_MAX_TRIPLES=500
DEFAULT_TIMEOUT=30
DEFAULT_CONFIDENCE_THRESHOLD=0.5

# Filtering Configuration
DEFAULT_RELEVANCE_THRESHOLD=0.7
DEFAULT_USE_LLM_FILTERING=true

# Summarization Configuration
DEFAULT_USE_COT=true
DEFAULT_STRATEGY=cot
