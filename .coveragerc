[run]
source = .
omit = 
    tests/*
    test_*.py
    */test_*.py
    */tests/*
    setup.py
    conftest.py
    */conftest.py
    */__pycache__/*
    */migrations/*
    */venv/*
    */env/*
    */site-packages/*
    htmlcov/*
    .coverage
    coverage.xml

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

[html]
directory = htmlcov

